{
  "name": "actiondeck",
  "version": "0.1.0",
  "description": "Local-first GitHub Actions workflow reviewer.",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "actiondeck": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js scan fixtures/sample-repo --format markdown && node dist/src/cli.js scan fixtures/sample-repo --format json --output /tmp/actiondeck-smoke.json && node dist/src/cli.js explain fixtures/sample-repo/.github/workflows/release.yml",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "github-actions",
    "ci",
    "workflow",
    "security",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/actiondeck.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/actiondeck/issues"
  },
  "homepage": "https://github.com/rogerchappel/actiondeck#readme"
}
